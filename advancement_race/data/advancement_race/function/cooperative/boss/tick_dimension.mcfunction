# Restore modified bosses outside an active Cooperative match.
execute unless data storage advancement_race:match {status:"active",mode:"cooperative_border"} as @e[type=minecraft:ender_dragon,tag=advancement_race_boss_modified] run function advancement_race:cooperative/boss/restore_dragon
