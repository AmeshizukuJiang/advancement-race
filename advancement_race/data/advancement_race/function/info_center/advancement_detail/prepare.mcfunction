$data modify storage advancement_race:runtime advancement_detail set value {advancement:"$(advancement)",title_translate:"$(title_translate)",base_score:$(base_score),events:[]}
data modify storage advancement_race:runtime advancement_detail.source set from storage advancement_race:runtime browser_work.session.source
$execute if data storage advancement_race:runtime advancement_detail{source:{kind:"current"}} run data modify storage advancement_race:runtime advancement_detail.events append from storage advancement_race:match events[{advancement:"$(advancement)"}]
execute if data storage advancement_race:runtime advancement_detail{source:{kind:"current"}} run data modify storage advancement_race:runtime advancement_detail.valid set value 1b
execute if data storage advancement_race:runtime advancement_detail{source:{kind:"current"}} store result score #advancement_detail_roster race_state run data get storage advancement_race:match participants
execute if data storage advancement_race:runtime advancement_detail{source:{kind:"history"}} run data modify storage advancement_race:runtime advancement_detail.match_id set from storage advancement_race:runtime advancement_detail.source.match_id
execute if data storage advancement_race:runtime advancement_detail{source:{kind:"history"}} if data storage advancement_race:runtime advancement_detail.match_id run function advancement_race:info_center/advancement_detail/prepare_history with storage advancement_race:runtime advancement_detail
execute unless data storage advancement_race:runtime advancement_detail{valid:1b} run tellraw @s [{"text":"That completed race is no longer available.","color":"#9B2226"}]
execute if data storage advancement_race:runtime advancement_detail{valid:1b} run function advancement_race:info_center/advancement_detail/finish
